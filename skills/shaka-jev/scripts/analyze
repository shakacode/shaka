#!/bin/sh
set -eu

fail() {
  printf 'shaka-jev: cannot select a trusted Ruby executable\n' >&2
  exit 1
}

resolve_file() {
  file=$1
  count=0
  while [ -L "$file" ]; do
    count=$((count + 1))
    [ "$count" -le 16 ] || return 1
    [ -x /usr/bin/readlink ] || return 1
    target=$(/usr/bin/readlink "$file") || return 1
    case "$target" in
      /*) file=$target ;;
      *) file=${file%/*}/$target ;;
    esac
  done
  directory=$(CDPATH= cd -P "${file%/*}" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$directory" "${file##*/}"
}

checkout=$(pwd -P) || fail
while [ "$checkout" != / ] && [ ! -e "$checkout/.git" ]; do
  checkout=${checkout%/*}
  [ -n "$checkout" ] || checkout=/
done
[ -e "$checkout/.git" ] || fail

remaining=${PATH-}
safe_path=
ruby=
while :; do
  case "$remaining" in
    *:*) entry=${remaining%%:*}; remaining=${remaining#*:}; more=true ;;
    *) entry=$remaining; more=false ;;
  esac
  directory=$(CDPATH= cd -P "${entry:-.}" 2>/dev/null && pwd -P) || directory=
  if [ -n "$directory" ]; then
    case "$directory" in
      "$checkout"|"$checkout"/*) ;;
      *)
        safe_path=${safe_path:+$safe_path:}$directory
        if [ -z "$ruby" ] && [ -f "$directory/ruby" ] && [ -x "$directory/ruby" ]; then
          selected=$(resolve_file "$directory/ruby") || selected=
          case "$selected" in
            "$checkout"|"$checkout"/*|'') ;;
            *) ruby=$selected ;;
          esac
        fi
        ;;
    esac
  fi
  [ "$more" = true ] || break
done
[ -n "$ruby" ] && [ -n "$safe_path" ] || fail
case "$0" in */*) ;; *) fail ;; esac
PATH=$safe_path
export PATH
unset RUBYOPT RUBYLIB
exec "$ruby" "$0.rb" "$@"
