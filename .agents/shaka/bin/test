#!/bin/sh
set -eu

root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
unset RUBYOPT RUBYLIB
export BUNDLE_GEMFILE="$root/Gemfile"
cd "$root"
exec bundle exec ruby -Itest -e '
  tests = ARGV.empty? ? Dir.glob("test/**/*_test.rb") : ARGV
  abort "Provide one or more test files." if tests.empty?
  tests.each { |path| require File.expand_path(path) }
' "$@"
