#!/usr/bin/env bash
# Scoped checks for local evidence: whitespace, docs navigation, the tests the change can reach, and
# RuboCop on the changed Ruby files. The required hosted validate check runs on every pull request
# push and runs the full suite for code changes.
set -euo pipefail

root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
base=${SHAKA_BASE_REF:-origin/main}
cd "$root"
comparison=$(git merge-base "$base" HEAD)

git diff --check "$comparison" HEAD --
git diff --cached --check HEAD --
git diff --check --

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
inventory=$scratch/inventory
errors=$scratch/errors
git ls-files --others --exclude-standard -z >"$inventory"
while IFS= read -r -d '' path; do
  # Exit status 1 means only that the new file differs from /dev/null; whitespace problems add 2.
  status=0
  git diff --no-index --check -- /dev/null "$path" 2>"$errors" || status=$?
  if [[ "$status" -ne 1 || -s "$errors" ]]; then
    cat "$errors" >&2
    exit 1
  fi
done <"$inventory"

# validate already handles a documentation-only change in seconds. Without exec, the trap removes
# the temporary files.
if [[ -x bin/docs-only-change ]] && bin/docs-only-change "$base" >/dev/null 2>&1; then
  "$root/.agents/shaka/bin/validate"
  exit
fi

unset RUBYOPT RUBYLIB
export BUNDLE_GEMFILE="$root/Gemfile"
ruby bin/check-docs-navigation
bundle exec ruby bin/run-tests --changed "$base"

git diff --name-only --no-renames -z "$comparison" -- >"$inventory"
git ls-files --others --exclude-standard -z >>"$inventory"
changed=()
while IFS= read -r -d '' path; do
  case "$path" in
    # Changing or deleting RuboCop's settings or gems can make any file offend.
    .rubocop.yml | */.rubocop.yml | Gemfile | Gemfile.lock | .ruby-version)
      bundle exec rubocop
      exit
      ;;
  esac
  # ruby-check skips deleted paths.
  changed+=("$path")
done <"$inventory"
((${#changed[@]} == 0)) || bundle exec ruby bin/lefthook/ruby-check lint "${changed[@]}"
