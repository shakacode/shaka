#!/usr/bin/env ruby
# frozen_string_literal: true

ENV['BUNDLE_GEMFILE'] = File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
require 'json'
require 'rexml/document'
require_relative '../lib/shaka_docs/audiences'

# Check the full published tree, so an already-merged orphan is caught too.
def document_ids(item)
  case item
  when String then [item]
  when Array then item.flat_map { |child| document_ids(child) }
  when Hash then sidebar_ids(item)
  else raise ArgumentError, "Unsupported sidebar item: #{item.inspect}"
  end
end

def sidebar_ids(item)
  case item['type']
  when 'link' then []
  when 'doc' then [item.fetch('id')]
  when 'category' then document_ids(item.fetch('items'))
  else raise ArgumentError, "Unsupported sidebar item: #{item.inspect}"
  end
end

# Code prints these into user output, so a heading rename in a docs-only PR would break them silently.
EMITTED_DOCS = %r{shakacode/shaka/blob/[^/\s]+/docs/([\w./-]+\.md)(?:#([\w-]+))?}

def prose(path)
  File.read(path, encoding: 'UTF-8').gsub(/^ {0,3}```.*?^ {0,3}```/m, '')
end

# GitHub's heading slugs for the heading forms these docs use; emphasis and {#id} are not modeled.
def slug(heading)
  text = heading.gsub(/<[^>]*>/, '').gsub(/\[([^\]]*)\]\([^)]*\)/, '\\1')
  text.downcase.strip.gsub(/[^\p{Word}\- ]/, '').tr(' ', '-')
end

def heading_ids(text)
  seen = Hash.new(0)
  text.scan(/^ {0,3}\#{1,6}[ \t]+(.+?)(?:[ \t]+#+)?[ \t]*$/).flatten.map do |heading|
    id = slug(heading)
    count = (seen[id] += 1) - 1
    count.zero? ? id : "#{id}-#{count}"
  end
end

def anchors(path)
  @anchors ||= {}
  @anchors[path] ||= begin
    text = prose(path)
    heading_ids(text) + text.scan(/<a\s+(?:id|name)\s*=\s*["']([^"']+)["']/).flatten
  end
end

def unresolved_anchor(path, fragment)
  anchor = URI::DEFAULT_PARSER.unescape(fragment.to_s)
  return if anchor.empty? || anchor.casecmp?('top')

  'missing anchor' if path.match?(/\.mdx?\z/) && !anchors(path).include?(anchor)
end

def unresolved(path, target)
  uri = ShakaDocs::Audiences.url(target)
  file = URI::DEFAULT_PARSER.unescape(uri.path)
  destination = file.empty? ? path : File.expand_path(file, File.dirname(path))
  return 'missing file' unless File.exist?(destination)

  unresolved_anchor(destination, uri.fragment)
end

def broken_relative_links(repository, path)
  ShakaDocs::Audiences.links(File.read(path, encoding: 'UTF-8'), include_html: false).filter_map do |target|
    next if target.match?(%r{\A(?:[a-z][\w+.-]*:|/)}i) || target.include?('{{')

    problem = unresolved(path, target)
    "#{path.delete_prefix("#{repository}/")} -> #{target} (#{problem})" if problem
  end
end

def broken_emitted_links(repository, docs, path)
  File.read(path, encoding: 'UTF-8').scrub.scan(EMITTED_DOCS).uniq.filter_map do |page, anchor|
    target = [page, anchor].compact.join('#')
    problem = unresolved(File.join(docs, 'index.md'), target)
    "#{path.delete_prefix("#{repository}/")} -> docs/#{target} (#{problem})" if problem
  end
end

def markdown_files(docs, repository)
  ShakaDocs::Audiences.document_files(repository).filter_map do |file|
    File.join(repository, file) if file.start_with?("#{File.basename(docs)}/", 'skills/')
  end
end

def emitted_sources(repository)
  ShakaDocs::Audiences.repository_paths(repository).grep(%r{\Askills/}).filter_map do |file|
    path = File.join(repository, file)
    path if File.file?(path)
  end
end

def broken_links(docs)
  docs = File.expand_path(docs)
  repository = File.dirname(docs)
  markdown = markdown_files(docs, repository)
  sources = markdown | emitted_sources(repository)
  markdown.flat_map { |path| broken_relative_links(repository, path) } +
    sources.flat_map { |path| broken_emitted_links(repository, docs, path) }
end

SVG_NAMESPACE = 'http://www.w3.org/2000/svg'

# A docs-only change skips the tests, so each figure must at least parse as an SVG document.
# The classifier accepts any name under img/, so the scan includes hidden paths and .SVG.
def malformed_figures(docs, paths)
  figures = paths.filter_map { |path| path.delete_prefix("#{docs}/") if path.start_with?("#{docs}/img/") }
  figures.grep(/\.svg\z/i).reject do |file|
    root = REXML::Document.new(File.read(File.join(docs, file), encoding: 'UTF-8')).root
    root&.name == 'svg' && root.namespace == SVG_NAMESPACE
  rescue REXML::ParseException
    false
  end
end

def source_components(path, repository)
  components = []
  prefix = "#{repository.delete_suffix('/')}/"
  while path != repository && path.start_with?(prefix)
    components << path
    path = File.dirname(path)
  end
  components
end

def reject_docs_symlinks(paths, repository)
  components = paths.flat_map { |path| source_components(path, repository) }.uniq
  aliases = components.select { |path| File.symlink?(path) }.map { |path| path.delete_prefix("#{repository}/") }
  raise ArgumentError, "Docs sources cannot be symlinks: #{aliases.join(', ')}" unless aliases.empty?
end

begin
  root = File.expand_path(ARGV.fetch(0, File.expand_path('../docs', __dir__)))
  repository = File.dirname(root)
  reject_docs_symlinks([root, File.join(root, 'sidebars.json')], repository)
  navigation = JSON.parse(File.read(File.join(root, 'sidebars.json')))
  raise ArgumentError, 'Expected a sidebar object' unless navigation.is_a?(Hash)

  ids = document_ids(navigation.fetch('docsSidebar'))
  prefix = "#{File.basename(root)}/"
  inventory = ShakaDocs::Audiences.repository_paths(repository)
  doc_paths = inventory.filter_map { |file| File.join(repository, file) if file.start_with?(prefix) }
  reject_docs_symlinks(doc_paths, repository)
  doc_paths.select! { |path| File.file?(path) }

  files = doc_paths.grep(/\.mdx?\z/i).map { |path| path.delete_prefix("#{root}/") }
  # Site discovery needs lowercase extensions and ignores dot, underscore and planning paths.
  excluded, published = files.partition do |file|
    !file.match?(/\.mdx?\z/) || file.split('/').any? { |part| part.start_with?('.', '_') } ||
      file.split('/')[0...-1].include?('planning')
  end
  pages = published.map { |file| file.sub(/\.(md|mdx)\z/, '') }
  missing = pages - ids
  stale = ids - pages
  agent_links = files.flat_map do |file|
    ShakaDocs::Audiences.agent_links(repository, File.join(root, file), File.read(File.join(root, file), encoding: 'UTF-8')).map { |link| "#{file} -> #{link}" }
  end
  sidebar_targets = navigation.values.flat_map { |sidebar| ShakaDocs::Audiences.navigation_links(sidebar) }
  sidebar_agents = ShakaDocs::Audiences.agent_targets(repository, File.join(root, 'sidebars.json'), sidebar_targets)
  agent_links.concat(sidebar_agents.map { |link| "sidebars.json -> #{link}" })
  agent_links.concat(files.select { |file| ShakaDocs::Audiences.agent_entry?(file) })
  unclassified = ShakaDocs::Audiences.unclassified_documents(repository)
  puts "Markdown outside established documentation locations: #{unclassified.join(', ')}" unless unclassified.empty?
  unless excluded.empty?
    puts "Site-excluded Markdown: #{excluded.join(', ')}; move product guides to visible docs/ paths, " \
         'or move non-site documents to their established destination.'
  end
  puts "Missing from docs/sidebars.json: #{missing.join(', ')}" unless missing.empty?
  puts "Navigation targets missing pages: #{stale.join(', ')}" unless stale.empty?
  puts "Link a human guide, not agent instructions: #{agent_links.join(', ')}" unless agent_links.empty?
  broken = broken_links(root)
  puts "Unresolved links in docs/ and skills/:\n#{broken.join("\n")}" unless broken.empty?
  malformed = malformed_figures(root, doc_paths)
  puts "Figures that do not parse as SVG: #{malformed.join(', ')}" unless malformed.empty?
  exit 1 unless [missing, stale, excluded, unclassified, agent_links, broken, malformed].all?(&:empty?)

  puts "All #{pages.size} published pages are in docs/sidebars.json and link no agent instructions; " \
       'Markdown links and heading anchors in docs/ and skills/ resolve; figures parse.'
rescue JSON::ParserError, KeyError, ArgumentError, Errno::ENOENT, Addressable::URI::InvalidURIError => e
  warn "Docs navigation check failed: #{e.message}"
  exit 1
end
