#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'
require 'optparse'
require_relative '../lib/shaka/evaluation/risk_replay'
require_relative '../lib/shaka/evaluation/risk_replay_score'
require_relative '../../skills/shaka/lib/shaka/configuration'

# Scores the private records a `review-replay --checkpoint-risk` run left in its state directory.
SOURCE = File.realpath('../..', __dir__)

def options
  options = {}
  parser = OptionParser.new do |flags|
    flags.banner = 'Usage: eval/bin/risk-replay-score --state DIR'
    flags.on('--state DIR') { |value| options[:state] = value }
  end
  parser.parse!
  raise ArgumentError, parser.to_s unless ARGV.empty? && options[:state]

  options
end

def records(state)
  Dir.glob(File.join(state, '*.json')).map { |path| JSON.parse(File.read(path, encoding: 'UTF-8')) }
end

def changed_paths(row)
  output, error, status = Open3.capture3('git', '-C', SOURCE, 'diff', '--name-only', '--no-renames', '-z',
                                         row.fetch('base'), row.fetch('head'))
  raise IOError, "Cannot read #{row.fetch('id')} files: #{error.strip}" unless status.success?

  output.split("\0")
end

# Each arm's own committed settings decide its risk areas and threshold, as they did in the replay's fresh
# fixture; a settings preview or individual settings in this checkout must not stand in for them.
def settings(records)
  records.to_h { |record| [record.fetch('arm'), record.dig('selection', 'criteria')] }.transform_values do |ref|
    config = Shaka::Configuration.trusted(root: SOURCE, ref:, candidate_commands: false)
    high, medium = Shaka::PostImplementationRisk.areas(config)
    { 'high' => high, 'medium' => medium, 'max_risk' => Shaka::PostImplementationRisk.max_risk(config) }
  end
end

# A state directory holds one comparison; records from another would be pooled under the same arm names.
# Returns the comparison's plan: its reviewer, effort, cases and repeats.
def one_comparison!(records)
  plans = records.map { |record| record['comparison'] }.uniq
  selections = records.map { |record| record.values_at('arm', 'selection') }.uniq
  arms = selections.map(&:first)
  return plans.first if plans.one? && plans.first && arms.uniq.size == arms.size

  raise ArgumentError, 'The state directory mixes comparisons; score each comparison from its own state directory'
end

begin
  saved = records(options.fetch(:state))
  raise ArgumentError, 'No replay records in the state directory' if saved.empty?

  plan = one_comparison!(saved)
  cases = File.foreach(Shaka::Evaluation::RiskReplay::CASE_FILE).to_h { |line| JSON.parse(line).then { |row| [row.fetch('id'), row] } }
  paths = cases.transform_values { |row| changed_paths(row) }
  score = Shaka::Evaluation::RiskReplayScore.score(records: saved, cases:, paths:, settings: settings(saved),
                                                   plan:)
  puts JSON.pretty_generate(score)
rescue ArgumentError, IndexError, IOError, SystemCallError, JSON::ParserError, OptionParser::ParseError,
       Shaka::Error => e
  warn "Score incomplete: #{e.message}"
  exit 1
end
