#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'json'
require 'open3'
require 'optparse'
require_relative '../lib/shaka/evaluation/risk_replay'
require_relative '../lib/shaka/evaluation/risk_replay_score'

# Scores the private records a `review-replay --checkpoint-risk` run left in its state directory.
SOURCE = File.realpath('../..', __dir__)

def options
  options = {}
  parser = OptionParser.new do |flags|
    flags.banner = 'Usage: eval/bin/risk-replay-score --state DIR'
    flags.on('--state DIR') { |value| options[:state] = value }
  end
  parser.parse!
  raise ArgumentError, parser.to_s unless ARGV.empty? && options[:state]

  options
end

def records(state)
  Dir.glob(File.join(state, '*.json')).map { |path| JSON.parse(File.read(path, encoding: 'UTF-8')) }
end

def changed_paths(row)
  # The fixture's sanitized Git environment, so a replacement ref or redirected repository cannot change the files.
  environment = Shaka::Evaluation::ReviewReplayFixture::GIT_ENVIRONMENT
  output, error, status = Open3.capture3(environment, 'git', *Shaka::Evaluation::ReviewReplayFixture::GIT_CONFIG,
                                         '-C', SOURCE, 'diff', '--name-only', '--no-renames', '-z',
                                         row.fetch('base'), row.fetch('head'))
  raise IOError, "Cannot read #{row.fetch('id')} files: #{error.strip}" unless status.success?

  output.split("\0")
end

# A state directory holds one replay invocation; records from another would be pooled under the same arm names.
def one_comparison!(records)
  plans = records.map { |record| record['comparison'] }.uniq
  return plans.first if plans.one? && plans.first

  raise ArgumentError, 'The state directory mixes comparisons; score each comparison from its own state directory'
end

# A case file or packet edited since the replay would rescore it silently against inputs it never read.
def unchanged_inputs!(plan)
  rows = File.foreach(Shaka::Evaluation::RiskReplay::CASE_FILE).map { |line| JSON.parse(line) }
  planned = rows.select { |row| plan.fetch('cases').include?(row.fetch('id')) }
  changed = recorded_inputs(plan, planned).filter_map { |name, (digest, path)| name if digest != sha256(path) }
  raise ArgumentError, "Changed since this replay: #{changed.join(', ')}" if changed.any?

  planned
end

def sha256(path) = Digest::SHA256.file(path).hexdigest

# Each input the replay read, with the digest it recorded and the file as it stands now.
def recorded_inputs(plan, planned)
  planned.to_h do |row|
    ["#{row.fetch('id')} packet",
     [plan.dig('packets', row.fetch('id')), File.join(Shaka::Evaluation::RiskReplay::CASES, row.fetch('packet'))]]
  end.merge('case file' => [plan['case_file'], Shaka::Evaluation::RiskReplay::CASE_FILE])
end

begin
  saved = records(options.fetch(:state))
  raise ArgumentError, 'No replay records in the state directory' if saved.empty?

  plan = one_comparison!(saved)
  cases = unchanged_inputs!(plan).to_h { |row| [row.fetch('id'), row] }
  paths = cases.transform_values { |row| changed_paths(row) }
  # The policy the replay checked before spending, so a later Shaka cannot change how these ratings score.
  settings = plan.fetch('arms').keys.to_h { |arm| [arm, plan.fetch('policy')] }
  score = Shaka::Evaluation::RiskReplayScore.score(records: saved, cases:, paths:, settings:, plan:)
  puts JSON.pretty_generate(score)
rescue ArgumentError, IndexError, IOError, SystemCallError, JSON::ParserError, OptionParser::ParseError,
       Shaka::Error => e
  warn "Score incomplete: #{e.message}"
  exit 1
end
