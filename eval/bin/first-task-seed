#!/usr/bin/env ruby
# frozen_string_literal: true

seed = '0eebcc10cc0d05ae33e0d1a95bc6a052cea4f5fd'
source = 'https://github.com/shaka-eval-repos/shaka-first-task-1131-20261110-r2.git'
abort 'Usage: eval/bin/first-task-seed NEW_DIRECTORY' unless ARGV.size == 1

destination = File.expand_path(ARGV.fetch(0))

def git(directory, *arguments)
  # Inherited Git variables can override -C.
  env = %w[GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
           GIT_OBJECT_DIRECTORY GIT_DIR GIT_WORK_TREE GIT_IMPLICIT_WORK_TREE GIT_GRAFT_FILE
           GIT_INDEX_FILE GIT_NO_REPLACE_OBJECTS GIT_REPLACE_REF_BASE GIT_PREFIX
           GIT_SHALLOW_FILE GIT_COMMON_DIR GIT_CEILING_DIRECTORIES].to_h { |name| [name, nil] }
  options = ['-c', "core.hooksPath=#{File.join(directory, '.git', 'disabled-hooks')}"]
  # Fetch can use the operator's network settings; checkout must materialize the pinned tree.
  if arguments.first == 'checkout'
    env.update('GIT_CONFIG_GLOBAL' => File::NULL, 'GIT_CONFIG_NOSYSTEM' => '1', 'GIT_ATTR_NOSYSTEM' => '1')
    options.push('-c', "core.attributesFile=#{File::NULL}")
  end
  system(env, 'git', *options, '-C', directory, *arguments, exception: true)
end

begin
  Dir.mkdir(destination)
  git(destination, 'init', '--quiet', '--template=', '--object-format=sha1', '--initial-branch=main')
  git(destination, 'fetch', '--quiet', '--no-tags', source, seed)
  git(destination, 'checkout', '--quiet', '-b', 'main', seed)
rescue SystemCallError, RuntimeError => e
  abort "Could not prepare first-task seed: #{e.message}"
end

puts "Prepared #{seed}. Run bin/validate in the new checkout before hosting it."
