+  def test_complete_records_are_emitted_while_next_record_is_incomplete
+    decoder = LineDecoder.new
+
+    assert_equal [{ 'id' => 'a' }], decoder.feed("{\"id\":\"a\"}\n{\"id\":")
+    assert_equal [{ 'id' => 'b' }, { 'id' => 'c' }],
+                 decoder.feed("\"b\"}\n{\"id\":\"c\"}\n{\"id\":")
+    assert_equal [{ 'id' => 'd' }], decoder.feed("\"d\"}\n")
+  end
