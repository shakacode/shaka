@@ -0,0 +1,40 @@
+# frozen_string_literal: true
+
+require 'minitest/autorun'
+require_relative '../lib/receiver'
+
+class ReceiverTest < Minitest::Test
+  def test_complete_records_are_delivered_before_partial_suffix
+    delivered = []
+    receiver = Receiver.new { |id| delivered << id }
+
+    receiver.receive("{\"id\":\"a\"}\n{\"id\":\"b\"}\n{\"id\":")
+    assert_equal %w[a b], delivered
+
+    receiver.receive('"c')
+    assert_equal %w[a b], delivered
+
+    receiver.receive("\"}\n{\"id\":\"d\"}\n")
+    assert_equal %w[a b c d], delivered
+
+    receiver.receive('')
+    assert_equal %w[a b c d], delivered
+  end
+
+  def test_delivery_at_every_chunk_boundary
+    stream = "{\"id\":\"a\"}\n{\"id\":\"b\"}\n{\"id\":\"c\"}\n"
+
+    (0..stream.length).each do |boundary|
+      delivered = []
+      receiver = Receiver.new { |id| delivered << id }
+      prefix = stream[0...boundary]
+
+      receiver.receive(prefix)
+      assert_equal %w[a b c].take(prefix.count("\n")), delivered,
+                   "delivery after prefix ending at #{boundary}"
+
+      receiver.receive(stream[boundary..])
+      assert_equal %w[a b c], delivered, "delivery after boundary #{boundary}"
+    end
+  end
+end
